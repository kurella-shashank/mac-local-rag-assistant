cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Secrets and environment variables
.env
.env.*
!.env.example
*.pem
*.key

# Local document and index data
data/
*.sqlite
*.sqlite3
*.db

# macOS
.DS_Store

# VS Code local settings
.vscode/

# Local logs
logs/
*.log
EOF